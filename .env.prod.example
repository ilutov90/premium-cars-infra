# Production settings for docker-compose.prod.yml (scripts/prod.sh reads .env.prod). Copy to .env.prod
# (git-ignored, on the server only) and fill in. Secrets of the backend (autowini, Meta, Viber, imgbb, Resend) do
# NOT go here: they go into Vault with `./scripts/prod.sh vault import`.

# The site's address (DNS A records for it and for www. point to the server)
SITE_DOMAIN=premiumcarsimport.bg
# Let's Encrypt account e-mail (expiry warnings)
ACME_EMAIL=

# Database: the backend's password (copied into Vault by vault-init) and the superuser's (maintenance only).
# Long random values, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_SUPERUSER_PASSWORD=

# Inquiry e-mails (empty = off). The sender must be on a domain verified in Resend.
NOTIFY_TO=
NOTIFY_FROM=Premium Cars Import <noreply@premiumcarsimport.bg>

# Cloudflare R2 for car photos (not secret; the access keys R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY go into Vault).
# Empty = photos stay in the media volume. Endpoint: R2 -> the bucket -> Settings -> S3 API.
R2_ENDPOINT=
R2_BUCKET=premium-cars-photos
# The bucket's custom domain (R2 -> the bucket -> Settings -> Custom Domains)
R2_PUBLIC_URL=https://img.premiumcarsimport.bg/
