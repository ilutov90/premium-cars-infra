# Copy to /etc/premium-cars/backup.env on the server (sudo, chmod 600). Not in git, not in Vault: backups must
# work even when Vault does not. Keep the same values in Bitwarden.
#
# Cloudflare R2: dashboard -> R2 -> bucket "premium-cars-backups"; R2 -> Manage API tokens -> Create
# (Object Read & Write, that bucket only) -> Access Key ID + Secret Access Key; the account id is in the R2 URL.
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/premium-cars-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Encrypts the backups. Long random value (openssl rand -hex 32). Lose it and the backups are lost too.
RESTIC_PASSWORD=
